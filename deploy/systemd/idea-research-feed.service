[Unit]
Description=Collect and publish the Idea Research feed
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=3h
StartLimitBurst=3

[Service]
Type=oneshot
User=idea-research
Group=idea-research
WorkingDirectory=/srv/idea-research
Environment=HOME=/home/idea-research
ExecStart=/srv/idea-research/scripts/update-feed.sh
TimeoutStartSec=8h
Restart=on-failure
RestartSec=15min

[Install]
WantedBy=multi-user.target
