# Reddit OAuth is optional. Public JSON/RSS is used before credentials are added.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ai-signal-research/0.1 (by u/your_reddit_username)
# Personal-account OAuth (preferred over app-only). One-time setup:
#   ai-signal reddit-auth
# which registers a 'script' app, prints an authorize URL, captures the
# permanent refresh token, and gives you the line to paste here. With this set
# the collector acts as that Reddit account under the `read` scope.
REDDIT_REFRESH_TOKEN=

# X/Twitter scraping credentials (any one route is enough per account):
#   1. TWITTER_COOKIES — session cookies for the twscrape transport (preferred).
#      Format: "auth_token=<...>; ct0=<...>" copied from a logged-in browser
#      (DevTools → Application → Cookies → https://x.com). Expires periodically.
#      Alternatively, put the same one-line value in credentials/x_twitter_cookies.txt.
#   2. X_BEARER_TOKEN — official X API v2 bearer token.
#   3. rss_url — per-account RSS feed in config/sources.yaml instead of credentials.
TWITTER_COOKIES=
TWITTER_COOKIES_2=
X_BEARER_TOKEN=

# Alpha Vantage end-of-day US top gainers/losers. Keep the real key only in .env.
ALPHAVANTAGE_API_KEY=
FMP_API_KEY=
